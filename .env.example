# =====================================================================
#  CONFIGURACIÓN DEL MVP — copia este archivo a `.env` y ajústalo
#  NOTA: todas las direcciones indicadas pertenecen a rangos privados
#  definidos en RFC 1918 (10/8, 172.16/12, 192.168/16) o a loopback.
# =====================================================================

# ---------- Red local (RFC 1918) ----------
# 0.0.0.0 permite escuchar en todas las interfaces de la LAN.
APP_HOST=0.0.0.0
PORT=4000
# URL pública (dentro de la LAN) donde se sirve el monolito:
PUBLIC_BASE_URL=http://192.168.100.38:4000
# Origen del frontend en desarrollo (Vite):
CLIENT_BASE_URL=http://192.168.100.38:5173
# Lista blanca de orígenes CORS / WebSocket (separados por coma):
CORS_ORIGINS=http://localhost:5173,http://192.168.100.38:5173,http://192.168.100.38:4000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.100.38:5173,http://192.168.100.38:4000
# Nº de saltos de proxy inverso confiables (0 = sin proxy):
TRUSTED_PROXY_HOPS=0

# ---------- Base de datos PostgreSQL ----------
POSTGRES_USER=anuncios
POSTGRES_PASSWORD=CambiaMe123!
POSTGRES_DB=anuncios
DATABASE_URL=postgres://anuncios:CambiaMe123!@127.0.0.1:5432/anuncios

# ---------- Seguridad (ISO/IEC 27001 A.5.17, A.8.24) ----------
# Genera un valor aleatorio largo para producción: `openssl rand -hex 48`
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=sid
BCRYPT_ROUNDS=12
# Usuario administrador inicial (se crea automáticamente si no existe):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin2026!Cambiame
# Límites de tasa (A.8.8 / protección contra fuerza bruta):
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
# Nivel de bitácora: debug | info | warn | error
LOG_LEVEL=info
